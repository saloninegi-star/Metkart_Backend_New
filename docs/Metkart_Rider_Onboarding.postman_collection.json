        {
          "name": "Approve Rider Application",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVE\",\n  \"reason\": \"All documents verified and in order.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/delivery/riders/{{riderId}}/review",
              "host": [
