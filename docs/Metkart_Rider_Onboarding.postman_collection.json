{
  "info": {
    "_postman_id": "metkart-delivery-dedicated-collection-id",
    "name": "Metkart Delivery App API",
    "description": "Dedicated Rider / Delivery Boy App backend module. All routes are mounted under `/api/delivery` (and `/api/rider`). Standard baseUrl is http://localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Rider App Auth & Contact",
      "item": [
        {
          "name": "Register Rider (/api/delivery/auth/register)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rider@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"RIDER\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/delivery/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "delivery",
                "auth",
                "register"
              ]
            },
            "description": "Dedicated Rider registration endpoint. Also accessible via `POST {{baseUrl}}/api/rider/auth/register`."
          }
        },
        {
          "name": "Verify Email OTP (/api/delivery/auth/otp/verify)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rider@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/delivery/auth/otp/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "delivery",
                "auth",
                "otp",
                "verify"
              ]
            },
            "description": "Verifies 6-digit email OTP and issues rider access and refresh JWTs. Also accessible via `POST {{baseUrl}}/api/rider/auth/otp/verify`."
          }
        },
        {
          "name": "Resend Email OTP (/api/delivery/auth/otp/resend)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rider@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/delivery/auth/otp/resend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "delivery",
                "auth",
                "otp",
                "resend"
              ]
            },
            "description": "Resends 6-digit email OTP (enforces 45s cooldown). Also accessible via `POST {{baseUrl}}/api/rider/auth/otp/resend`."
          }
        },
        {
          "name": "Login Rider (/api/delivery/auth/login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rider@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/delivery/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "delivery",
                "auth",
                "login"
              ]
            },
            "description": "Rider password login for verified email accounts. Also accessible via `POST {{baseUrl}}/api/rider/auth/login`."
          }
        },
        {
          "name": "Rotate Refresh Token (/api/delivery/auth/refresh)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/delivery/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "delivery",
                "auth",
                "refresh"
              ]
            },
            "description": "Rotates rider refresh token and returns new access token. Also accessible via `POST {{baseUrl}}/api/rider/auth/refresh`."
          }
        },
        {
          "name": "Update Contact Phone (/api/delivery/onboarding/contact)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{riderToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/delivery/onboarding/contact",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "delivery",
                "onboarding",
                "contact"
              ]
            },
            "description": "Updates rider mobile contact number. Also accessible via `PATCH {{baseUrl}}/api/rider/onboarding/contact`."
          }
        },
        {
          "name": "Register Rider (Alias: /api/rider/auth/register)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rider@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"RIDER\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rider/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rider",
                "auth",
                "register"
              ]
            },
            "description": "Direct Rider alias endpoint matching Customer/Vendor naming."
          }
        },
        {
          "name": "Login Rider (Alias: /api/rider/auth/login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rider@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rider/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rider",
                "auth",
                "login"
              ]
            },
            "description": "Direct Rider alias login endpoint."
          }
        }
      ]
    },
